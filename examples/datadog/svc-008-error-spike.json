{
  "name" : "[svc-008] error spike SLO burn rate",
  "type" : "query alert",
  "query" : "(sum(last_1h):sum:trace.http.request.errors{service:svc-008}.as_count() / sum:trace.http.request.hits{service:svc-008}.as_count()) > 0.0144",
  "message" : "{{#is_alert}}SLO burn rate error spike on svc-008. Runbook: https://runbooks.internal/svc-008/error_spike @slack-team-i{{/is_alert}}",
  "tags" : [ "service:svc-008", "team:team-i", "tier:2", "mode:error_spike", "managed-by:silent-failure-radar" ],
  "options" : {
    "notify_no_data" : false,
    "renotify_interval" : 0,
    "require_full_window" : false,
    "thresholds" : {
      "critical" : 0.0144,
      "warning" : 0.006
    }
  },
  "priority" : 2
}
